---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
}

const { title = '深夜チキンライス・ガイド' } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>
    <meta
　　    name="robots"
　　    content="noindex, nofollow, noarchive, noimageindex"
　　  />

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/fuwaimg.css" />

    <script is:inline src="/js/jquery.js"></script>
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />

    <a
      href="#"
      id="totop"
      class="totop-hidden"
      aria-label="ページ上部へ戻る"
    ></a>

    <script is:inline src="/js/common.js"></script>
    <script is:inline src="/js/fuwaimg.js"></script>
  </body>
</html>