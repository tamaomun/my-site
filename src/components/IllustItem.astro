---
interface Props {
  image: string;
  caption: string;
  showCaption?: boolean;
}

const { image, caption, showCaption = false } = Astro.props;
---

<li>
  <a
    href={image}
    data-fimg="sweets"
    class="fuwaimg"
    data-fcaption={caption}
  >
    <img src={image} alt={caption} />
  </a>

  {showCaption && (
  <p class="illust-caption">{caption}</p>
)}
</li>