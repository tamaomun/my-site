---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---


<Layout title="MEMO | 深夜チキンライス・ガイド">
 <div class="container">
    <section class="indent">
      <div class="memo-heading">
        <img src="/img/icon/memo.png" alt="MEMO" />
      </div>

     {
  posts.map((post) => (
    <a href={`/blog/${post.id}/`} class="memo-link">
      <div class="box1">
        <h6>
          {post.data.date.toLocaleDateString("ja-JP")}
        </h6>

        <h2>{post.data.title}</h2>

        <p>{post.data.description}</p>
      </div>
    </a>
  ))
}


      <ul class="pagination">
        <li>
          <a class="active">1</a>
        </li>
      </ul>
    </section>
  </div>
</Layout>


<style>
  .memo-link {
    color: white;
    text-decoration: none;
    display: block;
  }

  .memo-link h2 {
    color: white;
  }
  
  .memo-link h6 {
    margin-bottom: 5px;
   }

  .memo-link :global(h2) {
  margin-top: 0;
  margin-bottom: 5px;
  color: white;
  font-size: 14px;
}

.memo-link :global(p) {
  font-size: 13px;
  line-height: 1.7;
  margin-top: 0;
}
</style>