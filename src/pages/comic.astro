---
import Layout from "../layouts/Layout.astro";
import PaperItem from "../components/PaperItem.astro";
import { comics } from "../data/comics";
---

<Layout title="COMIC | 深夜チキンライス・ガイド">
  <div class="container">
    <section class="indent">
      <div class="comic-heading">
        <img src="/img/comic.png" alt="COMIC" />
      </div>

    {comics.map((comic) => (
     <PaperItem
      title={comic.title}
      image={comic.image}
      description={comic.description}
      buttons={comic.buttons}
     />
    ))}


    </section>
  </div>
</Layout>