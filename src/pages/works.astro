---
import Layout from "../layouts/Layout.astro";
import { works } from "../data/works";
---

<Layout title="WORKS | 深夜チキンライス・ガイド">
  <div class="container">
    <section>
      <h1>WORKS</h1>

      <nav class="work-tags" aria-label="作品の絞り込み">
        <button type="button" data-tag="all" class="active">すべて</button>
        <button type="button" data-tag="漫画">漫画</button>
        <button type="button" data-tag="イラスト">イラスト</button>
        <button type="button" data-tag="一枚絵">一枚絵</button>
        <button type="button" data-tag="漫画関連">漫画関連</button>
        <button type="button" data-tag="ペーパー">ペーパー</button>
      </nav>

      <div class="works-list">
        {works.map((work) => (
          <button
            type="button"
            class="work-item"
            data-tags={work.tags.join(",")}
            data-title={work.title}
            data-images={JSON.stringify(work.images ?? [work.thumbnail])}
            data-type={work.type}
          >
            <img src={work.thumbnail} alt="" />
            <span>{work.title}</span>
          </button>
        ))}
      </div>


  <div id="work-viewer" hidden>

   <button id="viewer-close" type="button" aria-label="閉じる">
    ×
   </button>

  <h3 id="viewer-title"></h3>

  <div class="viewer-status">
    <span id="viewer-count">1 / 1</span>
  </div>

  <div class="viewer-area">
    <button
      id="viewer-prev"
      class="viewer-arrow"
      type="button"
      aria-label="前へ"
    >
      ←
    </button>

    <div id="viewer-images"></div>

    <button
      id="viewer-next"
      class="viewer-arrow"
      type="button"
      aria-label="次へ"
    >
      →
    </button>
  </div>

</div>

</section>
</div>

  <script>
    const tagButtons = document.querySelectorAll(".work-tags button");
    const workItems = document.querySelectorAll(".work-item");
    const viewer = document.querySelector("#work-viewer");
    const viewerTitle = document.querySelector("#viewer-title");
    const viewerImages = document.querySelector("#viewer-images");
    const viewerPrev = document.querySelector("#viewer-prev");
    const viewerNext = document.querySelector("#viewer-next");
    const viewerCount = document.querySelector("#viewer-count");
    const viewerClose = document.querySelector("#viewer-close");

    let currentIndex = 0;
    let currentImages = [];
    let currentType = "illust";

    const isSpread = () => currentType === "comic" && window.innerWidth >= 701;

    function closeViewer() {
     if (viewer instanceof HTMLElement) {
       viewer.hidden = true;
     }
    }

    viewerClose?.addEventListener("click", closeViewer);

    document.addEventListener("keydown", (event) => {
     if (event.key === "Escape") {
      closeViewer();
     }
    });


    viewer?.addEventListener("click", (event) => {
     const target = event.target;

     if (!(target instanceof Element)) return;

     if (
        target.closest("#viewer-images, #viewer-prev, #viewer-next, #viewer-close, #viewer-title, .viewer-status")
      ) {return;}

      closeViewer();
      });

    
    
    function updateViewer() {
      if (!(viewerImages instanceof HTMLElement) || !(viewerCount instanceof HTMLElement)) return;

      const step = isSpread() ? 2 : 1;
      const spreadIndex = Math.floor(currentIndex / step);

      viewerImages.scrollTo({
        left: -viewerImages.clientWidth * spreadIndex,
        behavior: "smooth",
      });

      const first = currentIndex + 1;
      const last = Math.min(currentIndex + step, currentImages.length);
      viewerCount.textContent = step === 2 ? `${first}–${last} / ${currentImages.length}` : `${first} / ${currentImages.length}`;

      if (viewerPrev instanceof HTMLButtonElement) viewerPrev.disabled = currentIndex === 0;
      if (viewerNext instanceof HTMLButtonElement) viewerNext.disabled = last >= currentImages.length;
    }

    tagButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const tag = button.getAttribute("data-tag") ?? "all";

        tagButtons.forEach((btn) => btn.classList.toggle("active", btn === button));

        workItems.forEach((item) => {
          const tags = item.getAttribute("data-tags")?.split(",") ?? [];
          item.toggleAttribute("hidden", tag !== "all" && !tags.includes(tag));
        });
      });
    });

    workItems.forEach((item) => {
      item.addEventListener("click", () => {
        if (!(viewer instanceof HTMLElement) || !(viewerTitle instanceof HTMLElement) || !(viewerImages instanceof HTMLElement)) return;

        const title = item.getAttribute("data-title") ?? "";
        const images = JSON.parse(item.getAttribute("data-images") ?? "[]");
        currentType = item.getAttribute("data-type") ?? "illust";
        currentImages = images;
        currentIndex = 0;

        viewer.dataset.type = currentType;
        viewerTitle.textContent = title;
        viewerImages.replaceChildren();

        images.forEach((src) => {
          const page = document.createElement("div");
          page.className = "viewer-page";

          const img = document.createElement("img");
          img.src = src;
          img.alt = title;

          page.appendChild(img);
          viewerImages.appendChild(page);
        });

        viewer.hidden = false;
        updateViewer();
        
      });
    });

    viewerPrev?.addEventListener("click", () => {
      currentIndex = Math.max(0, currentIndex - (isSpread() ? 2 : 1));
      updateViewer();
    });

    viewerNext?.addEventListener("click", () => {
      currentIndex = Math.min(currentImages.length - 1, currentIndex + (isSpread() ? 2 : 1));
      updateViewer();
    });

    window.addEventListener("resize", updateViewer);
  </script>

  <style>

    /* =========================
    1. サムネ一覧
    ========================= */

    :root {
      /* サムネ */
      --work-gap: 10px;

      /* 作品ビュー */
      --viewer-height: 80vh;
    }

    .work-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 40px;
    }

    .work-tags button {
      padding: 6px 12px;
      border: 1px solid #999;
      border-radius: 20px;
      background: white;
      cursor: pointer;
      font: inherit;
    }

    .work-tags button.active {
      background: #333;
      color: white;
      border-color: #333;
    }

    .works-list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--work-gap);
    }

    .work-item {
      padding: 0;
      overflow: hidden;
      border: 1px solid #aaa;
      border-radius: 6px;
      background: transparent;
      color: white;
      cursor: pointer;
      font: inherit;
    }

    .work-item img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
    }

    .work-item span {
      display: block;
      padding: 8px 6px;
      font-size: 12px;
      line-height: 1.4;
      text-align: center;
      background: rgba(255, 255, 255, 0.08);
    }

    .work-item[hidden] { display: none; }


    /* =========================
    2. モーダル
    ========================= */

    #work-viewer {
     position: fixed;
     inset: 0;
     z-index: 1000;

     display: flex;
     flex-direction: column;
     justify-content: center;

     padding: 20px;

     background: rgba(0, 0, 0, 0.85);
     }

    #work-viewer[hidden] {display: none;}

 

   #viewer-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 10;

    border: 0;
    background: transparent;
    color: white;

    font-size: 32px;
    cursor: pointer;
    }


    #viewer-title,
     .viewer-status {
      width: min(1400px, 96vw);
      margin-left: auto;
      margin-right: auto;
      }

    .viewer-area {
     display: flex;
     align-items: center;
     gap: 12px;

     width: min(1400px, 96vw);
     margin: 0 auto;
     }

    #viewer-images {
      display: flex;
      flex: 1;
      min-width: 0;
      overflow-x: auto;
      direction: rtl;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
    }

    :global(.viewer-page) {
      flex: 0 0 100%;
      height: var(--viewer-height);
      display: flex;
      align-items: center;
      justify-content: center;
      scroll-snap-align: start;
    }

    #work-viewer[data-type="comic"] :global(.viewer-page) {
      flex-basis: 50%;
    }

    :global(.viewer-page img) {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .viewer-arrow {
      flex: 0 0 44px;
      width: 44px;
      height: 44px;
      border: 1px solid #999;
      border-radius: 50%;
      background: transparent;
      color: white;
      font-size: 20px;
      cursor: pointer;
    }

    .viewer-arrow:disabled { opacity: 0.25; cursor: default; }
    

    /* =========================
     3. スマホ
    ========================= */

    @media (max-width: 700px) {
      :root { --viewer-height: 70vh; }
      .works-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      #work-viewer[data-type="comic"] :global(.viewer-page) { flex-basis: 100%; }
      .viewer-area { width: 100%; gap: 6px; }
      .viewer-arrow { flex-basis: 36px; width: 36px; height: 36px; }
    }

  </style>
</Layout>
