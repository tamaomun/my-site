---
import Layout from "../layouts/Layout.astro";
import UpdateList from "../components/UpdateList.astro";
import { updates } from "../data/updates";
---

<Layout title="深夜チキンライス・ガイド">
  
    <div class="container">
      <img
        class="top-image"
        src="/img/top-index.jpg"
        alt="トップイラスト"
      />

      <section>
        <a href="/about" class="btn">
          初めての方はこちらをご一読下さい
        </a>

      <UpdateList updates={updates} />

       
      </section>
    </div>


  <style>
    .top-image {
      width: 100%;
      margin: 0;
    }

  </style>
</Layout>